// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PrincipalStatus {
  ACTIVE
  DISABLED
}

model Principal {
  id                      String                   @id @default(uuid()) @db.Uuid
  idpIssuer               String                   @map("idp_issuer")
  idpSubject              String                   @map("idp_subject")
  displayName             String?                  @map("display_name")
  status                  PrincipalStatus          @default(ACTIVE)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  projectMemberships      ProjectMembership[]
  organizationMemberships OrganizationMembership[]
  grantedProjectRoles     ProjectRoleAssignment[]  @relation("GrantedProjectRoles")

  @@unique([idpIssuer, idpSubject])
  @@map("principals")
}

enum OrganizationStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   OrganizationMembership[]
  projectScopes ProjectScope[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  principalId    String           @map("principal_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  principal    Principal    @relation(fields: [principalId], references: [id], onDelete: Restrict)

  @@unique([organizationId, principalId])
  @@index([principalId, status])
  @@map("organization_memberships")
}

enum ProjectScopeStatus {
  ACTIVE
  DISABLED
}

model ProjectMembership {
  id              String                  @id @default(uuid()) @db.Uuid
  projectId       String                  @map("project_id") @db.Uuid
  principalId     String                  @map("principal_id") @db.Uuid
  status          MembershipStatus        @default(ACTIVE)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  roleAssignments ProjectRoleAssignment[]
  project         ProjectScope            @relation(fields: [projectId], references: [projectId], onDelete: Restrict)
  principal       Principal               @relation(fields: [principalId], references: [id], onDelete: Restrict)

  @@unique([projectId, principalId])
  @@index([principalId, status])
  @@map("project_memberships")
}

model ProjectScope {
  projectId      String             @id @map("project_id") @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  displayName    String             @map("display_name")
  status         ProjectScopeStatus @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships  ProjectMembership[]

  @@index([organizationId, status])
  @@map("project_scopes")
}

model ProjectRole {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  assignments ProjectRoleAssignment[]

  @@map("roles")
}

model RolePermission {
  id        String @id @default(uuid()) @db.Uuid
  roleId    String @map("role_id") @db.Uuid
  actionKey String @map("action_key")

  role ProjectRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([roleId, actionKey])
  @@index([actionKey])
  @@map("role_permissions")
}

model ProjectRoleAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  grantedById  String?  @map("granted_by") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  membership ProjectMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  role       ProjectRole       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy  Principal?        @relation("GrantedProjectRoles", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([membershipId, roleId])
  @@index([roleId])
  @@index([grantedById])
  @@map("project_role_assignments")
}
